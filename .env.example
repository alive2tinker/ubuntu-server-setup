# Copy to .env, run chmod 600 .env, and edit the copy on your Ubuntu server.
# Commit this template; keep the real .env private and ignored by Git.
# Read as literal data: no $VAR expansion, command substitution, or escapes.
# Matching outer single/double quotes are optional and are removed.
# Put comments on their own lines. No multiline values or `export` prefix.

# SSH administrator: use your existing Ubuntu username or create a new one.
# Blank username prompts. A supplied password sets/replaces the account password.
# Blank password preserves an existing active password; otherwise setup prompts.
# For --non-interactive, a new/locked account needs a nonempty password here.
SSH_USERNAME=
SSH_PASSWORD=''

# local = installer creates a named tunnel after browser authorization on your Mac.
# remote = use a connector token from a tunnel you created in Cloudflare.
# skip = keep any existing tunnel, or defer tunnel setup on a fresh installation.
CLOUDFLARE_MODE=local

# Required for local/remote: hostname only, e.g. strata.your-domain.com.
# Supply a hostname under a domain you control in Cloudflare. No https:// or /v1.
CLOUDFLARE_HOSTNAME=

# Optional in local mode. Blank generates strata-<hostname-with-dashes>.
# Use 1-100 letters/digits/hyphens/underscores, starting with a letter or digit.
CLOUDFLARE_TUNNEL_NAME=

# Remote mode only. Paste ONLY the connector token, not the full install command
# and not a Cloudflare account API token. Leave blank for local/skip mode.
# Configure the remote tunnel's published application origin as http://127.0.0.1:8080.
CLOUDFLARE_TUNNEL_TOKEN=''

# true explicitly authorizes large model downloads and replacement of the serving
# model. false skips preparation and preserves any existing model. Downloads can
# exceed 80 GB. The exact plan is printed before download; true skips confirmation.
INSTALL_MODEL=true

# Choices: iq2_xs, q2_0, iq3_xxs, iq3_s. Initial default: iq2_xs.
STRATA_MODEL=iq2_xs

# Choices: 8k, 16k, 32k. Initial default: 16k.
STRATA_CONTEXT=16k

# Strata's API key is generated automatically and preserved across reruns.
# Retrieve it on the server with: sudo strata-station key
# No GPU driver URL, ROCm version, port, release URL, or API key is required here.
